pipeline {
    agent any

    parameters {
        string(
            name: 'S3_BUCKET',
            defaultValue: 'cdec-alpha-cbzpbp-dev-frontend',
            description: 'S3 bucket name'
        )

        string(
            name: 'CLOUDFRONT_DISTRIBUTION_ID',
            defaultValue: 'E38XVDSMMV4QDS',
            description: 'CloudFront distribution ID'
        )

        string(
            name: 'VITE_AUTH_API',
            defaultValue: 'https://api.naturecric.online/api/auth',
            description: 'Auth API URL'
        )

        string(
            name: 'VITE_COURSE_API',
            defaultValue: 'https://api.naturecric.online/api/courses',
            description: 'Course API URL'
        )

        string(
            name: 'VITE_ENROLL_API',
            defaultValue: 'https://api.naturecric.online/api/enroll',
            description: 'Enrollment API URL'
        )
    }

    environment {
        APP_DIR = 'application/frontend'
        AWS_DEFAULT_REGION = 'ap-south-1'
    }

    stages {

        stage('Checkout') {
            steps {
                git(
                    url: 'https://github.com/Pushkar-6920/cdec-alpha-app.git',
                    branch: 'main'
                )
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    echo "===== Node ====="
                    node --version

                    echo "===== npm ====="
                    npm --version

                    echo "===== AWS CLI ====="
                    aws --version
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                }
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh """
                        export VITE_AUTH_API='${params.VITE_AUTH_API}'
                        export VITE_COURSE_API='${params.VITE_COURSE_API}'
                        export VITE_ENROLL_API='${params.VITE_ENROLL_API}'

                        npm run build
                    """
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-frontend-deploy',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.APP_DIR) {
                        sh """
                            echo "Uploading frontend..."
                            aws s3 sync dist/ s3://${params.S3_BUCKET}/ --delete
                        """
                    }
                }
            }
        }

        stage('Invalidate CloudFront') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-frontend-deploy',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        echo "Invalidating CloudFront..."

                        aws cloudfront create-invalidation \
                            --distribution-id ${params.CLOUDFRONT_DISTRIBUTION_ID} \
                            --paths "/*"
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend deployed successfully!'
        }

        failure {
            echo 'Frontend deployment failed. Check the stage logs above.'
        }
    }
}
